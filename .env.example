# ANNE Core environment variables
# Copy this file to .env and fill in values as needed.
# The system works fully with MockProvider when no API keys are set.

# Optional: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: xAI / Grok (OpenAI-compatible endpoint)
# XAI_API_KEY=xai-...
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-3

# Memory database path (default: anne_memory.db in current directory)
# ANNE_MEMORY_PATH=./anne_memory.db

# Log level
# ANNE_LOG_LEVEL=INFO
